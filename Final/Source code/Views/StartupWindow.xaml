<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ProjectTest.Views.StartupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MyShop Gaming Accessories">

    <Grid Background="{ThemeResource AppCanvasBrush}">
        <Border
            Width="520"
            Padding="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource PageSurfaceBrush}"
            BorderBrush="{ThemeResource CardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="28">
            <StackPanel Spacing="18">
                <Border
                    HorizontalAlignment="Left"
                    Padding="14,7"
                    Background="{ThemeResource AccentSoftBrush}"
                    CornerRadius="999">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentBrush}"
                        Text="MyShop Gaming Accessories POS" />
                </Border>

                <TextBlock
                    FontFamily="Segoe UI Variable Display Semib"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Text="Starting workspace"
                    TextWrapping="WrapWholeWords" />

                <TextBlock
                    Style="{ThemeResource PageIntroTextBlockStyle}"
                    Text="Loading settings, database schema, plugins, and saved login." />

                <ProgressRing
                    Width="42"
                    Height="42"
                    HorizontalAlignment="Left"
                    IsActive="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
