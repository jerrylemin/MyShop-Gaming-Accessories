<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectTest.Views.Pages.ProductEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="{ThemeResource AppCanvasBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Margin="28" Spacing="18">
            <StackPanel Spacing="12">
                <Button Click="BackButton_Click" Content="Back" />
                <StackPanel>
                    <TextBlock
                        Style="{ThemeResource PageTitleTextBlockStyle}"
                        Text="{Binding PageTitle}" />
                    <TextBlock
                        Foreground="#FF5C5750"
                        Text="Maintain gaming accessory details, generic specs, prices, inventory, and gallery paths."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </StackPanel>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="14" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="SKU" />
                            <TextBox Text="{Binding SKU, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Name" />
                            <TextBox Text="{Binding Name, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock Text="Brand" />
                            <TextBox Text="{Binding Manufacturer, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                            <TextBlock Text="Category" />
                            <ComboBox
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Categories}"
                                SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay}"
                                SelectedValuePath="Id" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="6">
                            <TextBlock Text="Spec 1" />
                            <TextBox Text="{Binding CPU, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                            <TextBlock Text="Spec 2" />
                            <TextBox Text="{Binding RAM, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Spacing="6">
                            <TextBlock Text="Spec 3" />
                            <TextBox Text="{Binding Storage, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                            <TextBlock Text="Spec 4" />
                            <TextBox Text="{Binding GPU, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Spacing="6">
                            <TextBlock Text="Spec 5" />
                            <TextBox Text="{Binding Screen, Mode=TwoWay}" />
                        </StackPanel>
                        <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Import price" />
                                <TextBox Text="{Binding ImportPrice, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Sale price" />
                                <TextBox Text="{Binding SalePrice, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6">
                                <TextBlock Text="Stock" />
                                <TextBox Text="{Binding Stock, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Spacing="6">
                            <TextBlock Text="Description" />
                            <TextBox
                                AcceptsReturn="True"
                                MinHeight="120"
                                Text="{Binding Description, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Image 1" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Image1, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    Click="BrowseImage1Button_Click"
                                    Content="Browse" />
                            </Grid>
                            <Image
                                MaxHeight="220"
                                Stretch="Uniform"
                                Source="{Binding Image1, Converter={StaticResource ImagePathConverter}}" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Image 2" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Image2, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    Click="BrowseImage2Button_Click"
                                    Content="Browse" />
                            </Grid>
                            <Image
                                MaxHeight="220"
                                Stretch="Uniform"
                                Source="{Binding Image2, Converter={StaticResource ImagePathConverter}}" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Image 3" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Image3, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    Click="BrowseImage3Button_Click"
                                    Content="Browse" />
                            </Grid>
                            <Image
                                MaxHeight="220"
                                Stretch="Uniform"
                                Source="{Binding Image3, Converter={StaticResource ImagePathConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource AccentBrush}"
                        Text="{Binding StatusMessage}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding AutoSaveStatus}" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding SaveCommand}" Content="Save Product" />
                        <Button Grid.Column="1" Click="BackButton_Click" Content="Cancel" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
