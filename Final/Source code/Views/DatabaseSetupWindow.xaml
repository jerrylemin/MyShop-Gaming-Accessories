<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ProjectTest.Views.DatabaseSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Database Setup">

    <ScrollViewer
        x:Name="RootGrid"
        Background="{ThemeResource AppCanvasBrush}"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="1100"
            Margin="24"
            HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Padding="36"
                Background="{ThemeResource SidebarBrush}"
                CornerRadius="34,34,0,0">
                <Grid>
                    <Ellipse
                        Width="340"
                        Height="340"
                        Margin="-120,-120,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="#14FFFFFF" />
                    <Ellipse
                        Width="280"
                        Height="280"
                        Margin="0,0,-80,-60"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Fill="#16FFFFFF" />

                    <StackPanel
                        MaxWidth="620"
                        VerticalAlignment="Center"
                        Spacing="16">
                        <Border
                            HorizontalAlignment="Left"
                            Padding="14,7"
                            Background="#20FFFFFF"
                            CornerRadius="999">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="PostgreSQL Setup" />
                        </Border>
                        <TextBlock
                            FontFamily="Segoe UI Variable Display Semib"
                            FontSize="40"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Connect the database before entering the app." />
                        <TextBlock
                            FontSize="16"
                            Foreground="#D9FFFFFF"
                            Text="Save a working connection string, test it again, then continue directly into the main workspace."
                            TextWrapping="WrapWholeWords" />

                        <Border
                            Padding="18"
                            Background="#14FFFFFF"
                            CornerRadius="22">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="#E7FFFFFF"
                                    Text="Note" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#D4FFFFFF"
                                    Text="If `MYSHOP_CONNECTION_STRING` exists, the app still gives that value top priority."
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="36"
                Background="{ThemeResource PageSurfaceBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="0,0,34,34">
                <StackPanel
                    MaxWidth="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="18">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Style="{ThemeResource PageTitleTextBlockStyle}"
                            Text="Database Connection Required" />
                        <TextBlock
                            Style="{ThemeResource PageIntroTextBlockStyle}"
                            Text="MyShop Gaming Accessories could not connect to PostgreSQL during startup. Update the connection string here and try again." />
                    </StackPanel>

                    <Border
                        Padding="16"
                        Background="#FFFCEDEE"
                        CornerRadius="18">
                        <TextBlock
                            Foreground="{ThemeResource DangerBrush}"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="WrapWholeWords" />
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{ThemeResource FieldLabelTextBlockStyle}"
                            Text="Connection string" />
                        <TextBox
                            AcceptsReturn="True"
                            MinHeight="140"
                            Text="{Binding ConnectionString, Mode=TwoWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{ThemeResource FieldLabelTextBlockStyle}"
                            Text="Template" />
                        <TextBox
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            MinHeight="96"
                            Text="{Binding TemplateConnectionString}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource AccentBrush}"
                        Text="{Binding StatusMessage}"
                        TextWrapping="WrapWholeWords" />

                    <Button
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Content="Save and reconnect" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
