<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectTest.Views.Pages.OrdersPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="{ThemeResource AppCanvasBrush}">

    <Grid Padding="28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Foreground="#FF5C5750"
                Text="Create, update, search by date range, inspect, and remove orders while keeping stock in sync."
                TextWrapping="WrapWholeWords" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10">
                <Button Command="{Binding NewOrderCommand}" Content="New Order" />
                <Button Command="{Binding SaveCommand}" Content="Save Order" />
                <Button Click="DeleteButton_Click" Content="Delete Order" />
                <Button Command="{Binding RefreshCommand}" Content="Refresh" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{ThemeResource SectionHeaderTextBlockStyle}"
                        Text="Order History" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DatePicker Date="{Binding FromDate, Mode=TwoWay}" />
                        <DatePicker
                            Grid.Column="1"
                            Date="{Binding ToDate, Mode=TwoWay}" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding ApplyDateFilterCommand}"
                            Content="Apply Range" />
                    </Grid>

                    <ListView
                        x:Name="OrdersListView"
                        ItemsSource="{Binding Orders}"
                        SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                        SelectionChanged="OrdersListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,4"
                                    Padding="12"
                                    Background="#FFFFFFFF"
                                    BorderBrush="{ThemeResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding OrderLabel}" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding CreatedDisplay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding FinalPriceText}" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding StatusLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Order Editor" />

                        <TextBlock
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Paid and cancelled orders remain visible for detail review but can no longer be changed." />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Created date" />
                                <DatePicker
                                    Date="{Binding DraftCreatedTime, Mode=TwoWay}"
                                    IsEnabled="{Binding CanEditCurrentOrder}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Status" />
                                <ComboBox
                                    IsEnabled="{Binding CanEditCurrentOrder}"
                                    ItemsSource="{Binding StatusOptions}"
                                    SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                DisplayMemberPath="DisplayName"
                                IsEnabled="{Binding CanEditCurrentOrder}"
                                ItemsSource="{Binding AvailableProducts}"
                                SelectedItem="{Binding SelectedProductToAdd, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding AddItemCommand}"
                                Content="Add Item" />
                        </Grid>

                        <ListView
                            ItemsSource="{Binding DraftItems}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,4"
                                        Padding="12"
                                        Background="#FFFFFFFF"
                                        BorderBrush="{ThemeResource CardStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Image
                                                Width="72"
                                                Height="54"
                                                Stretch="UniformToFill"
                                                Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding ProductName}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Manufacturer}" />
                                            </StackPanel>
                                            <NumberBox
                                                Grid.Column="2"
                                                IsEnabled="{Binding DataContext.CanEditCurrentOrder, ElementName=RootPage}"
                                                MinWidth="110"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{Binding QuantityValue, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding UnitSalePrice, Converter={StaticResource CurrencyConverter}}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding LineTotalText}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="4"
                                                Click="RemoveLineButton_Click"
                                                Content="Remove"
                                                IsEnabled="{Binding DataContext.CanEditCurrentOrder, ElementName=RootPage}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border
                            Padding="14"
                            Background="{ThemeResource AccentSoftBrush}"
                            CornerRadius="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Draft Total" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontFamily="Bahnschrift"
                                    FontSize="22"
                                    Text="{Binding DraftTotalText}" />
                            </Grid>
                        </Border>

                        <TextBlock
                            Foreground="{ThemeResource AccentBrush}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
