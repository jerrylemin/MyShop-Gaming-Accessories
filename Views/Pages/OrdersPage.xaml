<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectTest.Views.Pages.OrdersPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ProjectTest.Models"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="{ThemeResource AppCanvasBrush}">

    <ScrollViewer
        x:Name="OrdersPageScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel Margin="28" Spacing="18">

        <Border Style="{ThemeResource HeroCardBorderStyle}">
            <Grid ColumnSpacing="18" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="10">
                    <Border
                        HorizontalAlignment="Left"
                        Style="{ThemeResource BadgeBorderStyle}">
                        <TextBlock
                            Style="{ThemeResource BadgeTextBlockStyle}"
                            Text="Orders" />
                    </Border>
                    <TextBlock
                        FontFamily="Segoe UI Variable Display Semib"
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="Manage orders"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Grid
                    Grid.Column="1"
                    ColumnSpacing="12"
                    RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button
                        Grid.Column="0"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{Binding NewOrderCommand}"
                        Content="New Order" />
                    <Button
                        Grid.Column="1"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Content="{Binding EditorActionText}" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Click="DeleteButton_Click"
                        Content="Delete Order" />
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Foreground="{ThemeResource AccentBrush}"
                    Text="{Binding StatusMessage}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Text="{Binding AutoSaveStatus}" />
            </Grid>
        </Border>

        <Grid x:Name="OrdersWorkspaceGrid" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Order Filters" />

                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                PlaceholderText="Search by order id, status, product name, brand, or SKU"
                                Text="{Binding Keyword, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="0"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding StatusFilters}"
                                SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                ItemsSource="{Binding SortOptions}"
                                SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" />
                            <DatePicker
                                Grid.Row="2"
                                Grid.Column="0"
                                Date="{Binding FromDate, Mode=TwoWay}" />
                            <DatePicker
                                Grid.Row="2"
                                Grid.Column="1"
                                Date="{Binding ToDate, Mode=TwoWay}" />
                        </Grid>

                        <Button
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{Binding ApplyDateFilterCommand}"
                            Content="Apply Range" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Style="{ThemeResource CardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Order History" />

                        <ListView
                            x:Name="OrdersListView"
                            Grid.Row="1"
                            ItemsSource="{Binding Orders}"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                            SelectionChanged="OrdersListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,4"
                                        Padding="12"
                                        Background="{ThemeResource PageSurfaceBrush}"
                                        BorderBrush="{ThemeResource CardStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding OrderLabel}" TextWrapping="WrapWholeWords" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding CreatedDisplay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding FinalPriceText}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding StatusLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid
                            Grid.Row="2"
                            ColumnSpacing="12"
                            RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding PageSummary}"
                                TextWrapping="WrapWholeWords" />

                            <Grid
                                Grid.Column="1"
                                ColumnSpacing="10"
                                RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Command="{Binding FirstPageCommand}" Content="First" />
                                <Button Grid.Row="0" Grid.Column="1" Command="{Binding PreviousPageCommand}" Content="Previous" />
                                <Button Grid.Row="1" Grid.Column="0" Command="{Binding NextPageCommand}" Content="Next" />
                                <Button Grid.Row="1" Grid.Column="1" Command="{Binding LastPageCommand}" Content="Last" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Column="1"
                Style="{ThemeResource CardBorderStyle}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock
                                Style="{ThemeResource SectionHeaderTextBlockStyle}"
                                Text="Order Editor" />
                            <TextBlock
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Paid and cancelled orders are read-only." />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{Binding SaveCommand}"
                            Content="{Binding EditorActionText}" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="12"
                        RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Created date" />
                            <DatePicker
                                Date="{Binding DraftCreatedTime, Mode=TwoWay}"
                                IsEnabled="{Binding CanEditCurrentOrder}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Status" />
                            <ComboBox
                                IsEnabled="{Binding CanEditCurrentOrder}"
                                ItemsSource="{Binding StatusOptions}"
                                SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock Text="Customer" />
                            <ComboBox
                                DisplayMemberPath="Name"
                                IsEnabled="{Binding CanEditCurrentOrder}"
                                ItemsSource="{Binding Customers}"
                                SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                            <TextBlock Text="Promotion" />
                            <ComboBox
                                DisplayMemberPath="Code"
                                IsEnabled="{Binding CanEditCurrentOrder}"
                                ItemsSource="{Binding Promotions}"
                                SelectedItem="{Binding SelectedPromotion, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid
                        Grid.Row="2"
                        ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            DisplayMemberPath="DisplayName"
                            IsEnabled="{Binding CanEditCurrentOrder}"
                            ItemsSource="{Binding AvailableProducts}"
                            SelectedItem="{Binding SelectedProductToAdd, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding AddItemCommand}"
                            Content="Add Product" />
                    </Grid>

                    <ListView
                        Grid.Row="3"
                        ItemsSource="{Binding DraftItems}"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,4"
                                    Padding="12"
                                    Background="{ThemeResource PageSurfaceBrush}"
                                    BorderBrush="{ThemeResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Image
                                                Width="72"
                                                Height="54"
                                                Stretch="UniformToFill"
                                                Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding ProductName}" TextWrapping="WrapWholeWords" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Manufacturer}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="2"
                                                Click="RemoveLineButton_Click"
                                                Content="Remove"
                                                IsEnabled="{Binding DataContext.CanEditCurrentOrder, ElementName=RootPage}" />
                                        </Grid>

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <NumberBox
                                                Grid.Column="0"
                                                IsEnabled="{Binding DataContext.CanEditCurrentOrder, ElementName=RootPage}"
                                                MinWidth="110"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{Binding QuantityValue, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding UnitSalePrice, Converter={StaticResource CurrencyConverter}}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Unit price" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding LineTotalText}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Line total" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border
                        Grid.Row="4"
                        Padding="14"
                        Background="{ThemeResource AccentSoftBrush}"
                        CornerRadius="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="Draft Total" />
                                <TextBlock
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Use the action button on the right to create or update the order." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{Binding DiscountAmountText}" />
                                <TextBlock
                                    FontFamily="Bahnschrift"
                                    FontSize="22"
                                    Text="{Binding DraftTotalText}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{Binding SaveCommand}"
                                Content="{Binding EditorActionText}" />
                        </Grid>
                    </Border>
                    <Button
                        Grid.Row="5"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0"
                        Command="{Binding PrintCommand}"
                        Content="Print / Export invoice" />
                </Grid>
            </Border>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
