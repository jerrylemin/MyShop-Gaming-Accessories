<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectTest.Views.Pages.OrdersPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ProjectTest.Models"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="{ThemeResource AppCanvasBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Margin="28" Spacing="18">
            <Border Style="{ThemeResource HeroCardBorderStyle}">
                <StackPanel Spacing="14">
                    <Border
                        HorizontalAlignment="Left"
                        Style="{ThemeResource BadgeBorderStyle}">
                        <TextBlock
                            Style="{ThemeResource BadgeTextBlockStyle}"
                            Text="Transaction Workspace" />
                    </Border>
                    <TextBlock
                        FontFamily="Segoe UI Variable Display Semib"
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="Create orders and keep stock in sync in real time."
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Style="{ThemeResource PageIntroTextBlockStyle}"
                        Text="Create, edit, filter by date range, inspect details, and delete orders while inventory stays synchronized." />

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button
                            Grid.Column="0"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{Binding NewOrderCommand}"
                            Content="New Order" />
                        <Button
                            Grid.Column="1"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Command="{Binding SaveCommand}"
                            Content="Save Order" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Click="DeleteButton_Click"
                            Content="Delete Order" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{ThemeResource SectionHeaderTextBlockStyle}"
                        Text="Order History" />

                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            PlaceholderText="Search by order id, status, product name, brand, or SKU"
                            Text="{Binding Keyword, Mode=TwoWay}" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="0"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding StatusFilters}"
                            SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            ItemsSource="{Binding SortOptions}"
                            SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" />
                        <DatePicker
                            Grid.Row="2"
                            Grid.Column="0"
                            Date="{Binding FromDate, Mode=TwoWay}" />
                        <DatePicker
                            Grid.Row="2"
                            Grid.Column="1"
                            Date="{Binding ToDate, Mode=TwoWay}" />
                    </Grid>

                    <Button
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{Binding ApplyDateFilterCommand}"
                        Content="Apply Range" />

                    <ListView
                        x:Name="OrdersListView"
                        ItemsSource="{Binding Orders}"
                        SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                        SelectionChanged="OrdersListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,4"
                                    Padding="12"
                                    Background="{ThemeResource PageSurfaceBrush}"
                                    BorderBrush="{ThemeResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding OrderLabel}" TextWrapping="WrapWholeWords" />
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding CreatedDisplay}" />
                                        <TextBlock FontWeight="SemiBold" Text="{Binding FinalPriceText}" />
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding StatusLabel}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="{Binding PageSummary}"
                            TextWrapping="WrapWholeWords" />
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Command="{Binding FirstPageCommand}" Content="First" />
                            <Button Grid.Row="0" Grid.Column="1" Command="{Binding PreviousPageCommand}" Content="Previous" />
                            <Button Grid.Row="1" Grid.Column="0" Command="{Binding NextPageCommand}" Content="Next" />
                            <Button Grid.Row="1" Grid.Column="1" Command="{Binding LastPageCommand}" Content="Last" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Order Editor" />

                        <TextBlock
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Paid and cancelled orders remain visible for detail review but can no longer be changed." />

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Created date" />
                                <DatePicker
                                    Date="{Binding DraftCreatedTime, Mode=TwoWay}"
                                    IsEnabled="{Binding CanEditCurrentOrder}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Status" />
                                <ComboBox
                                    IsEnabled="{Binding CanEditCurrentOrder}"
                                    ItemsSource="{Binding StatusOptions}"
                                    SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="10">
                            <ComboBox
                                DisplayMemberPath="DisplayName"
                                IsEnabled="{Binding CanEditCurrentOrder}"
                                ItemsSource="{Binding AvailableProducts}"
                                SelectedItem="{Binding SelectedProductToAdd, Mode=TwoWay}" />
                            <Button
                                Command="{Binding AddItemCommand}"
                                Content="Add Item" />
                        </StackPanel>

                        <ListView
                            ItemsSource="{Binding DraftItems}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,4"
                                        Padding="12"
                                        Background="{ThemeResource PageSurfaceBrush}"
                                        BorderBrush="{ThemeResource CardStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Image
                                                    Width="72"
                                                    Height="54"
                                                    Stretch="UniformToFill"
                                                    Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding ProductName}" TextWrapping="WrapWholeWords" />
                                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Manufacturer}" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid ColumnSpacing="10" RowSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <NumberBox
                                                    Grid.Row="0"
                                                    Grid.ColumnSpan="2"
                                                    IsEnabled="{Binding DataContext.CanEditCurrentOrder, ElementName=RootPage}"
                                                    MinWidth="110"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{Binding QuantityValue, Mode=TwoWay}" />
                                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding UnitSalePrice, Converter={StaticResource CurrencyConverter}}" />
                                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding LineTotalText}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Click="RemoveLineButton_Click"
                                                    Content="Remove"
                                                    IsEnabled="{Binding DataContext.CanEditCurrentOrder, ElementName=RootPage}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border
                            Padding="14"
                            Background="{ThemeResource AccentSoftBrush}"
                            CornerRadius="16">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="Draft Total" />
                                <TextBlock
                                    FontFamily="Bahnschrift"
                                    FontSize="22"
                                    Text="{Binding DraftTotalText}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Foreground="{ThemeResource AccentBrush}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
