<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectTest.Views.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    Background="{ThemeResource AppCanvasBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
        <StackPanel Margin="28" Spacing="18">
            <Border Style="{ThemeResource HeroCardBorderStyle}">
                <Grid ColumnSpacing="18" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10">
                        <Border HorizontalAlignment="Left" Style="{ThemeResource BadgeBorderStyle}">
                            <TextBlock Style="{ThemeResource BadgeTextBlockStyle}" Text="Customers" />
                        </Border>
                        <TextBlock FontFamily="Segoe UI Variable Display Semib" FontSize="32" FontWeight="SemiBold" Text="Customer management" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <Grid Grid.Column="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{ThemeResource SubtleButtonStyle}" Command="{Binding RefreshCommand}" Content="Refresh" />
                        <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Command="{Binding NewCommand}" Content="New Customer" />
                    </Grid>
                </Grid>
            </Border>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <Border Style="{ThemeResource CardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{ThemeResource SectionHeaderTextBlockStyle}" Text="Customer list" />
                        <ListView Grid.Row="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" Padding="12" Background="{ThemeResource PageSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="16">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="WrapWholeWords" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Phone}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Email}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding LoyaltySummary}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding LifetimeSpendText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{ThemeResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{ThemeResource SectionHeaderTextBlockStyle}" Text="Customer info" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox Grid.Row="0" Grid.ColumnSpan="2" Header="Name" Text="{Binding Name, Mode=TwoWay}" />
                                <TextBox Grid.Row="1" Grid.Column="0" Header="Phone" Text="{Binding Phone, Mode=TwoWay}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Header="Email" Text="{Binding Email, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{ThemeResource AccentButtonStyle}" Command="{Binding SaveCommand}" Content="Save Customer" />
                                <Button Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}" Command="{Binding DeleteCommand}" Content="Delete Customer" />
                            </Grid>
                            <TextBlock Foreground="{ThemeResource AccentBrush}" Text="{Binding StatusMessage}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{ThemeResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{ThemeResource SectionHeaderTextBlockStyle}" Text="Customer summary" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Orders" />
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding ProfileSummary}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Loyalty" />
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding LoyaltySummary}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Paid spend" />
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding TotalSpendText}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{ThemeResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{ThemeResource SectionHeaderTextBlockStyle}" Text="Purchased products" />
                                <ListView ItemsSource="{Binding PurchasedProducts}" SelectionMode="None" MaxHeight="360">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding ProductName}" TextWrapping="WrapWholeWords" />
                                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Brand}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding QuantityText}" />
                                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding TotalSpendText}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{ThemeResource SectionHeaderTextBlockStyle}" Text="Order history" />
                                <ListView ItemsSource="{Binding OrderHistory}" SelectionMode="None" MaxHeight="360">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding OrderLabel}" />
                                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding CreatedDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding FinalPriceText}" />
                                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding StatusLabel}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
