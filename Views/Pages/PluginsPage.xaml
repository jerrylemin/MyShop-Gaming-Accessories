<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectTest.Views.Pages.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    Background="{ThemeResource AppCanvasBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
        <StackPanel Margin="28" Spacing="18">
            <Border Style="{ThemeResource HeroCardBorderStyle}">
                <Grid ColumnSpacing="18" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10">
                        <Border HorizontalAlignment="Left" Style="{ThemeResource BadgeBorderStyle}">
                            <TextBlock Style="{ThemeResource BadgeTextBlockStyle}" Text="Plugins" />
                        </Border>
                        <TextBlock FontFamily="Segoe UI Variable Display Semib" FontSize="32" FontWeight="SemiBold" Text="Dynamic plugin architecture" />
                        <TextBlock Style="{ThemeResource PageIntroTextBlockStyle}" Text="{Binding ArchitectureSummary}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <Grid Grid.Column="1" ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Style="{ThemeResource AccentButtonStyle}" Command="{Binding RefreshCommand}" Content="Refresh" />
                        <Button Grid.Row="0" Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}" Command="{Binding CreateSamplesCommand}" Content="Create Samples" />
                        <Button Grid.Row="1" Grid.ColumnSpan="2" Style="{ThemeResource SubtleButtonStyle}" Command="{Binding OpenFolderCommand}" Content="Open Plugins Folder" />
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{ThemeResource SectionHeaderTextBlockStyle}" Text="Loaded plugins" />
                    <TextBlock Foreground="{ThemeResource AccentBrush}" Text="{Binding StatusMessage}" TextWrapping="WrapWholeWords" />
                    <ListView ItemsSource="{Binding Plugins}" SelectionMode="None" MaxHeight="620" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,5" Padding="14" Background="{ThemeResource PageSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="16">
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Description}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding CapabilitiesText}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding FolderPath}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Status}" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Version}" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Type}" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding LastLoadedText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
