<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectTest.Views.Pages.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ProjectTest.Models"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="{ThemeResource AppCanvasBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Margin="28" Spacing="18">
            <Border Style="{ThemeResource HeroCardBorderStyle}">
                <StackPanel Spacing="14">
                    <Border
                        HorizontalAlignment="Left"
                        Style="{ThemeResource BadgeBorderStyle}">
                        <TextBlock
                            Style="{ThemeResource BadgeTextBlockStyle}"
                            Text="Master Data" />
                    </Border>
                    <TextBlock
                        FontFamily="Segoe UI Variable Display Semib"
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="Manage products in a cleaner, clearer workflow."
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        MaxWidth="860"
                        Style="{ThemeResource PageIntroTextBlockStyle}"
                        Text="Filter by category, search by keyword, limit by price, import from Excel, and review each product together with its image gallery." />

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button
                            Grid.Column="0"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Click="ImportExcelButton_Click"
                            Content="Import Excel" />
                        <Button
                            Grid.Column="1"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{Binding AddCommand}"
                            Content="Add Product" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Command="{Binding EditCommand}"
                            Content="Edit Product" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Click="DeleteButton_Click"
                            Content="Delete Product" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            PlaceholderText="Search by name, SKU, brand, description, or accessory specs"
                            Text="{Binding Keyword, Mode=TwoWay}" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="0"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding CategoryFilters}"
                            SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            ItemsSource="{Binding SortOptions}"
                            SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="0"
                            PlaceholderText="Min price"
                            Text="{Binding MinPrice, Mode=TwoWay}" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            PlaceholderText="Max price"
                            Text="{Binding MaxPrice, Mode=TwoWay}" />
                    </Grid>

                    <Button
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="Apply Filters" />

                    <TextBlock
                        Foreground="{ThemeResource AccentBrush}"
                        Text="{Binding StatusMessage}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{ThemeResource SectionHeaderTextBlockStyle}"
                        Text="Product List" />

                    <ListView
                        ItemsSource="{Binding Products}"
                        SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,4"
                                    Padding="12"
                                    Background="{ThemeResource PageSurfaceBrush}"
                                    BorderBrush="{ThemeResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Image
                                                Width="90"
                                                Height="68"
                                                Stretch="UniformToFill"
                                                Source="{Binding Image1, Converter={StaticResource ImagePathConverter}}" />

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}"
                                                    TextWrapping="WrapWholeWords" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Brand}" />
                                                <TextBlock
                                                    Foreground="#FF5C5750"
                                                    Text="{Binding Category.Name}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding SalePrice, Converter={StaticResource CurrencyConverter}}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Price" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Stock}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="In stock" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="{Binding PageSummary}"
                            TextWrapping="WrapWholeWords" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding PreviousPageCommand}" Content="Previous" />
                            <Button Grid.Column="1" Command="{Binding NextPageCommand}" Content="Next" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{ThemeResource SectionHeaderTextBlockStyle}"
                        Text="Product Detail" />

                    <TextBlock
                        FontFamily="Bahnschrift"
                        FontSize="24"
                        Text="{Binding SelectedProduct.Name}"
                        TextWrapping="WrapWholeWords" />

                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Brand" />
                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding SelectedProduct.Brand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Category" />
                            <TextBlock Text="{Binding SelectedProduct.Category.Name}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="SKU" />
                            <TextBlock Text="{Binding SelectedProduct.SKU}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>

                    <TextBlock FontWeight="SemiBold" Text="Accessory Specs" />
                    <ItemsControl ItemsSource="{Binding SelectedProduct.AccessorySpecs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="10"
                                    Background="{ThemeResource AppCanvasBrush}"
                                    CornerRadius="12">
                                    <TextBlock Text="{Binding}" TextWrapping="WrapWholeWords" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Import price" />
                            <TextBlock Text="{Binding SelectedProduct.ImportPrice, Converter={StaticResource CurrencyConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Sale price" />
                            <TextBlock Text="{Binding SelectedProduct.SalePrice, Converter={StaticResource CurrencyConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Stock" />
                            <TextBlock Text="{Binding SelectedProduct.Stock}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock FontWeight="SemiBold" Text="Description" />
                    <TextBlock
                        Text="{Binding SelectedProduct.Description}"
                        TextWrapping="WrapWholeWords" />

                    <TextBlock FontWeight="SemiBold" Text="Image Gallery" />
                    <StackPanel Spacing="10">
                        <Image
                            MaxHeight="220"
                            Stretch="Uniform"
                            Source="{Binding SelectedProduct.Image1, Converter={StaticResource ImagePathConverter}}" />
                        <Image
                            MaxHeight="220"
                            Stretch="Uniform"
                            Source="{Binding SelectedProduct.Image2, Converter={StaticResource ImagePathConverter}}" />
                        <Image
                            MaxHeight="220"
                            Stretch="Uniform"
                            Source="{Binding SelectedProduct.Image3, Converter={StaticResource ImagePathConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock
                        Style="{ThemeResource SectionHeaderTextBlockStyle}"
                        Text="Category Management" />
                    <TextBlock
                        Style="{ThemeResource PageIntroTextBlockStyle}"
                        Text="Add, edit, and delete categories safely. Categories that are still used by products cannot be deleted." />

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button
                            Grid.Column="0"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{Binding AddCategoryCommand}"
                            Content="Add Category" />
                        <Button
                            Grid.Column="1"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Command="{Binding EditCategoryCommand}"
                            Content="Edit Category" />
                        <Button
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Command="{Binding DeleteCategoryCommand}"
                            Content="Delete Category" />
                    </Grid>

                    <ListView
                        ItemsSource="{Binding ManagedCategories}"
                        SelectedItem="{Binding SelectedCategoryItem, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CategoryListItem">
                                <Border
                                    Margin="0,4"
                                    Padding="14"
                                    Background="{ThemeResource PageSurfaceBrush}"
                                    BorderBrush="{ThemeResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Description}" />
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind ProductCount}" />
                                            <TextBlock
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ProductCountText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
