<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectTest.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="{ThemeResource AppCanvasBrush}">

    <ScrollViewer>
        <StackPanel Margin="28" Spacing="18">
            <Border Style="{ThemeResource HeroCardBorderStyle}">
                <StackPanel Spacing="10">
                    <Border Style="{ThemeResource BadgeBorderStyle}">
                        <TextBlock
                            Style="{ThemeResource BadgeTextBlockStyle}"
                            Text="Preferences" />
                    </Border>
                    <TextBlock
                        FontFamily="Segoe UI Variable Display Semib"
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="Settings" />
                    <TextBlock
                        Style="{ThemeResource PageIntroTextBlockStyle}"
                        Text="Manage app preferences and tools." />
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock
                        Style="{ThemeResource SectionHeaderTextBlockStyle}"
                        Text="General" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Items per page" />
                        <ComboBox
                            ItemsSource="{Binding PageSizeOptions}"
                            SelectedItem="{Binding SelectedItemsPerPage, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Last opened screen" />
                        <TextBox
                            IsReadOnly="True"
                            Text="{Binding LastOpenedScreen}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock
                        Style="{ThemeResource SectionHeaderTextBlockStyle}"
                        Text="Credentials" />
                    <TextBlock
                        Text="{Binding CredentialStatus}"
                        TextWrapping="WrapWholeWords" />
                    <Button
                        Command="{Binding ClearCredentialsCommand}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Content="Clear Saved Login" />
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{ThemeResource SectionHeaderTextBlockStyle}" Text="License" />
                    <TextBlock Text="{Binding LicenseStatus}" TextWrapping="WrapWholeWords" />
                    <TextBox PlaceholderText="Activation code" Text="{Binding ActivationCode, Mode=TwoWay}" />
                    <Button Command="{Binding ActivateCommand}" Content="Activate" />
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{ThemeResource SectionHeaderTextBlockStyle}" Text="Backup / Restore" />
                    <TextBox PlaceholderText="Backup file path" Text="{Binding BackupPath, Mode=TwoWay}" />
                    <Button Command="{Binding BackupCommand}" Content="Backup database" />
                    <TextBox PlaceholderText="Restore file path" Text="{Binding RestorePath, Mode=TwoWay}" />
                    <Button Command="{Binding RestoreCommand}" Content="Restore database" />
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{ThemeResource SectionHeaderTextBlockStyle}" Text="LLM / SLM Assistant" />
                    <TextBox PlaceholderText="API key or use MYSHOP_LLM_API_KEY" Text="{Binding LlmApiKey, Mode=TwoWay}" />
                    <TextBox PlaceholderText="Endpoint" Text="{Binding LlmEndpoint, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{ThemeResource SectionHeaderTextBlockStyle}" Text="GraphQL Demo" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Run POS GraphQL queries."
                        TextWrapping="WrapWholeWords" />
                    <TextBox
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        MinHeight="220"
                        Text="{Binding GraphQlQuery, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{Binding ExecuteGraphQlCommand}"
                            Content="Execute GraphQL" />
                        <Button
                            Grid.Column="1"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Command="{Binding LoadSampleGraphQlCommand}"
                            Content="Load Sample" />
                    </Grid>
                    <TextBox
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        MinHeight="220"
                        Text="{Binding GraphQlResult}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{ThemeResource SectionHeaderTextBlockStyle}" Text="Plugins" />
                    <ListView ItemsSource="{Binding Plugins}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Status}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Style="{ThemeResource CardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{ThemeResource SectionHeaderTextBlockStyle}" Text="Customer Loyalty" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Paid orders increase loyalty points for the selected customer in Orders."
                        TextWrapping="WrapWholeWords" />
                    <ListView ItemsSource="{Binding Customers}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="WrapWholeWords" />
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding Phone}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding LoyaltySummary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding LifetimeSpendText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <TextBlock
                Foreground="{ThemeResource AccentBrush}"
                Text="{Binding StatusMessage}"
                TextWrapping="WrapWholeWords" />

            <Button
                Style="{ThemeResource AccentButtonStyle}"
                Command="{Binding SaveCommand}"
                Content="Save Settings" />
        </StackPanel>
    </ScrollViewer>
</Page>
