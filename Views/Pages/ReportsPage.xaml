<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectTest.Views.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ProjectTest.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light"
    NavigationCacheMode="Required"
    Background="{ThemeResource AppCanvasBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Margin="28" Spacing="18">
            <Border Style="{ThemeResource HeroCardBorderStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10">
                        <Border Style="{ThemeResource BadgeBorderStyle}">
                            <TextBlock
                                Style="{ThemeResource BadgeTextBlockStyle}"
                                Text="Business Insight" />
                        </Border>
                        <TextBlock
                            FontFamily="Segoe UI Variable Display Semib"
                            FontSize="32"
                            FontWeight="SemiBold"
                            Text="Báo cáo doanh thu theo từng nhịp vận hành." />
                        <TextBlock
                            Style="{ThemeResource PageIntroTextBlockStyle}"
                            Text="Quan sát doanh thu theo ngày, tuần, tháng, năm và xem nhóm sản phẩm bán mạnh nhất trong khoảng thời gian bạn chọn." />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <DatePicker Date="{Binding FromDate, Mode=TwoWay}" />
                        <DatePicker Date="{Binding ToDate, Mode=TwoWay}" />
                        <Button
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Content="Apply Range" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{Binding RangeLabel}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Total Revenue In Range" />
                        <TextBlock
                            FontFamily="Segoe UI Variable Display Semib"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="{Binding TotalRevenueText}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Total Profit In Range" />
                        <TextBlock
                            FontFamily="Segoe UI Variable Display Semib"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="{Binding TotalProfitText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Revenue by Day" />
                        <controls:SimpleLineChart ItemsSource="{Binding RevenueByDay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Profit by Day" />
                        <controls:SimpleLineChart ItemsSource="{Binding ProfitByDay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Revenue by Week" />
                        <controls:SimpleBarChart ItemsSource="{Binding RevenueByWeek}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Profit by Week" />
                        <controls:SimpleBarChart ItemsSource="{Binding ProfitByWeek}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Revenue by Month" />
                        <controls:SimpleBarChart ItemsSource="{Binding RevenueByMonth}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Profit by Month" />
                        <controls:SimpleBarChart ItemsSource="{Binding ProfitByMonth}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Revenue by Year" />
                        <controls:SimpleBarChart ItemsSource="{Binding RevenueByYear}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Profit by Year" />
                        <controls:SimpleBarChart ItemsSource="{Binding ProfitByYear}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Top Selling Gaming Accessories" />
                        <controls:SimpleBarChart ItemsSource="{Binding ProductSalesByRange}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Gaming Accessories Sales Share" />
                        <controls:SimplePieChart ItemsSource="{Binding ProductSalesShare}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
