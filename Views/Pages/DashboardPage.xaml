<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjectTest.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ProjectTest.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ProjectTest.Models"
    mc:Ignorable="d"
    RequestedTheme="Light"
    NavigationCacheMode="Required"
    Background="{ThemeResource AppCanvasBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Margin="28" Spacing="24">
            <Border Style="{ThemeResource HeroCardBorderStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="12">
                        <Border Style="{ThemeResource BadgeBorderStyle}">
                            <TextBlock
                                Style="{ThemeResource BadgeTextBlockStyle}"
                                Text="Daily Control Center" />
                        </Border>
                        <TextBlock
                            FontFamily="Segoe UI Variable Display Semib"
                            FontSize="38"
                            FontWeight="SemiBold"
                            Text="Tổng quan hoạt động cửa hàng hôm nay." />
                        <TextBlock
                            Style="{ThemeResource PageIntroTextBlockStyle}"
                            Text="Theo dõi tồn kho thấp, sản phẩm bán chạy, ba đơn gần nhất và xu hướng doanh thu theo ngày trong tháng hiện tại." />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="18"
                        Background="#FFFFFFFF"
                        BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Focus" />
                            <TextBlock
                                FontFamily="Segoe UI Variable Display Semib"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Text="{Binding LowStockProductsText}" />
                            <TextBlock
                                Style="{ThemeResource PageIntroTextBlockStyle}"
                                Text="Sản phẩm đang chạm ngưỡng cần nhập thêm." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:StatCard
                    Title="Total Products"
                    Value="{Binding TotalProductsText}"
                    Subtitle="Current catalog size across the gaming accessories assortment." />
                <controls:StatCard
                    Grid.Column="1"
                    AccentBrush="{ThemeResource HighlightBrush}"
                    Title="Low Stock"
                    Value="{Binding LowStockProductsText}"
                    Subtitle="Gaming accessories at or below the replenishment threshold." />
                <controls:StatCard
                    Grid.Column="2"
                    AccentBrush="{ThemeResource AccentBrush}"
                    Title="Today Orders"
                    Value="{Binding TodayOrderCountText}"
                    Subtitle="Orders created today across all statuses." />
                <controls:StatCard
                    Grid.Column="3"
                    AccentBrush="{ThemeResource AccentBrush}"
                    Title="Today Revenue"
                    Value="{Binding TodayRevenueText}"
                    Subtitle="Completed sales captured since midnight." />
            </Grid>

                <Border Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                        Text="Current Month Revenue" />
                    <controls:SimpleLineChart ItemsSource="{Binding RevenuePoints}" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Top 5 Low Stock" />
                        <ListView
                            IsItemClickEnabled="False"
                            ItemsSource="{Binding TopLowStockProducts}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Product">
                                    <Border
                                        Margin="0,5"
                                        Padding="12"
                                        Background="{ThemeResource AppCanvasBrush}"
                                        CornerRadius="18">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind Category.Name}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Stock}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Units left" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Top 5 Best Selling" />
                        <ListView
                            IsItemClickEnabled="False"
                            ItemsSource="{Binding TopSellingProducts}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductSalesSummary">
                                    <Border
                                        Margin="0,5"
                                        Padding="12"
                                        Background="{ThemeResource AppCanvasBrush}"
                                        CornerRadius="18">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ProductName}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind Manufacturer}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind QuantitySold}" />
                                                <TextBlock
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind RevenueText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{ThemeResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Style="{ThemeResource SectionHeaderTextBlockStyle}"
                            Text="Latest 3 Orders" />
                        <ListView
                            IsItemClickEnabled="False"
                            ItemsSource="{Binding LatestOrders}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:OrderSummary">
                                    <Border
                                        Margin="0,5"
                                        Padding="12"
                                        Background="{ThemeResource AppCanvasBrush}"
                                        CornerRadius="18">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind OrderLabel}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind CreatedDisplay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind FinalPriceText}" />
                                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind StatusLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
